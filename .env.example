# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the API listens on
PORT=5000

# MongoDB connection string (e.g. MongoDB Atlas SRV URI)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Origin allowed by CORS (the frontend dev/prod URL)
FRONTEND_URL=http://localhost:5173

# Secret used to sign/HMAC session identifiers — generate a long random string
SESSION_SECRET=change-me-to-a-long-random-value

# How many days a login session stays valid
SESSION_DURATION_DAYS=7

# development | production
NODE_ENV=development
