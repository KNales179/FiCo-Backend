# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the API listens on
PORT=5000

# MongoDB connection string (e.g. MongoDB Atlas SRV URI)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# The frontend's origin(s), for CORS — comma-separated if there's more than
# one (e.g. a Vercel production domain plus its own preview-deployment URL).
# Must be an exact origin: scheme + host, no path, no trailing slash.
FRONTEND_URL=http://localhost:5173

# Secret used to sign/HMAC session identifiers — generate a long random
# string (e.g. `openssl rand -hex 32`). Required in production — the server
# refuses to boot without it there.
SESSION_SECRET=change-me-to-a-long-random-value

# How many days a login session stays valid
SESSION_DURATION_DAYS=7

# development | production — also controls the session cookie's
# Secure/SameSite attributes (see utils/session.ts): production sets
# SameSite=None + Secure, required for a frontend and backend deployed to
# two different domains (e.g. Vercel + Render) to share the login cookie
# at all. Leaving this unset in production silently breaks login.
NODE_ENV=development

# Cloudinary — receipt/attachment and profile-picture storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Web push (Account page's "push notifications" toggle, bill reminders,
# activity/feedback alerts). Optional — every push send is a no-op until
# both keys are set. Generate a pair with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Shown to push services as the sender contact — any mailto: works.
VAPID_SUBJECT=mailto:you@example.com

# Brevo — sends the two transactional emails Fico ever sends (verify email,
# reset password). Optional — registration/login still work without it,
# just without those two emails actually being delivered.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Fico

# How long ActionLog / AdminAuditLog entries are kept before their TTL index
# expires them. Optional — both default to 365 days.
ACTION_LOG_TTL_DAYS=365
ADMIN_AUDIT_LOG_TTL_DAYS=365
